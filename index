<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Happy 1 Month 💗</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: "Arial", sans-serif;
            background: linear-gradient(180deg, #ffc1d0, #ff9db5);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* หัวใจลอย */
        .heart {
            position: absolute;
            color: rgba(255, 255, 255, 0.7);
            font-size: 25px;
            animation: float 5s infinite ease-in-out;
        }

        .heart:nth-child(1) {
            top: 15%;
            left: 12%;
        }

        .heart:nth-child(2) {
            top: 25%;
            right: 15%;
            animation-delay: 1s;
        }

        .heart:nth-child(3) {
            bottom: 20%;
            left: 18%;
            animation-delay: 2s;
        }

        .heart:nth-child(4) {
            bottom: 15%;
            right: 20%;
            animation-delay: 3s;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-15px);
            }
        }

        .container {
            width: 90%;
            max-width: 500px;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .title {
            font-size: clamp(45px, 12vw, 75px);
            font-weight: 800;
            line-height: 0.95;
            color: #ffffff;
            text-shadow:
                3px 3px 0 #d97896,
                -1px -1px 0 #d97896,
                1px -1px 0 #d97896,
                -1px 1px 0 #d97896;
            margin-bottom: 10px;
        }

        .month {
            font-size: clamp(40px, 11vw, 65px);
            color: #fff;
            font-weight: 700;
            text-shadow:
                3px 3px 0 #8f79c9,
                -1px -1px 0 #8f79c9,
                1px -1px 0 #8f79c9,
                -1px 1px 0 #8f79c9;
        }

        .sparkle {
            font-size: 35px;
            margin: 15px 0;
        }

        .card {
            margin-top: 25px;
            padding: 38px 25px;
            background: rgba(255, 245, 248, 0.9);
            border-radius: 35px;
            box-shadow: 0 15px 40px rgba(180, 75, 105, 0.18);
            backdrop-filter: blur(10px);
        }

        .card h2 {
            color: #d45d7d;
            font-size: 25px;
            margin-bottom: 8px;
        }

        .card p {
            color: #d98ca2;
            font-size: 15px;
            margin-bottom: 22px;
        }

        .password {
            width: 100%;
            height: 58px;
            border: 2px solid #f2b2c4;
            border-radius: 20px;
            background: #fff0f5;
            text-align: center;
            font-size: 25px;
            letter-spacing: 10px;
            color: #c95478;
            outline: none;
        }

        .password:focus {
            border-color: #d97896;
            box-shadow: 0 0 0 4px rgba(217, 120, 150, 0.12);
        }

        .password::placeholder {
            color: #dfafbd;
            letter-spacing: 8px;
        }

        button {
            margin-top: 20px;
            width: 100%;
            height: 52px;
            border: none;
            border-radius: 18px;
            background: #e87998;
            color: white;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        button:hover {
            background: #d96182;
            transform: translateY(-2px);
        }

        .error {
            height: 22px;
            margin-top: 13px;
            color: #d94d70;
            font-size: 14px;
            font-weight: bold;
        }

        .hint {
            margin-top: 18px;
            font-size: 12px;
            color: #d89aaa;
        }
    </style>
</head>

<body>

    <!-- หัวใจตกแต่ง -->
    <div class="heart">♡</div>
    <div class="heart">♡</div>
    <div class="heart">♡</div>
    <div class="heart">♡</div>

    <div class="container">

        <div class="title">
            Happy
        </div>

        <div class="month">
            1 Month
        </div>

        <div class="sparkle">
            ✨ 💗 ✨
        </div>

        <div class="card">

            <h2>ครบรอบ 1 เดือน 💕</h2>

            <p>
                ยินดีต้อนรับเข้าสู่ความทรงจำของเรานะ
            </p>

            <input
                id="password"
                class="password"
                type="password"
                inputmode="numeric"
                maxlength="6"
                placeholder="••••••"
                autocomplete="off"
            >

            <button onclick="checkPassword()">
                เปิดความทรงจำ 💗
            </button>

            <div id="error" class="error"></div>

            <div class="hint">
                ใส่รหัส 6 หลักเพื่อไปหน้าถัดไป
            </div>

        </div>
    </div>

    <script>

        function checkPassword() {

            const password = document.getElementById("password").value;
            const error = document.getElementById("error");

            // รหัสที่ถูกต้อง
            const correctPassword = "310869";

            if (password === correctPassword) {

                // ถ้ารหัสถูก → ไปหน้าที่ 2
                window.location.href = "page2.html";

            } else {

                // ถ้ารหัสผิด → อยู่หน้าเดิม
                error.textContent = "รหัสไม่ถูกต้อง ลองใหม่อีกครั้งนะ 💗";

                document.getElementById("password").value = "";

            }
        }

        // กด Enter เพื่อส่งรหัสได้
        document.getElementById("password").addEventListener("keydown", function(event) {

            if (event.key === "Enter") {
                checkPassword();
            }

        });

    </script>

</body>
</html>
